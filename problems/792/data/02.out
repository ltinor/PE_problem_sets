PE 792: Too Many Twos / 太多2

=== v₂(n) for n = 1..32 ===
  v₂( 1) = 0    v₂( 2) = 1    v₂( 3) = 0    v₂( 4) = 2
  v₂( 6) = 1    v₂( 8) = 3
  v₂(10) = 1    v₂(12) = 2
  v₂(14) = 1    v₂(16) = 4
  v₂(18) = 1    v₂(20) = 2
  v₂(22) = 1    v₂(24) = 3
  v₂(26) = 1    v₂(28) = 2
  v₂(30) = 1    v₂(32) = 5


=== v₂(n!) for various n ===
  v₂(  5!) =    3  (direct: 3)  s₂(5) = 2
  v₂( 10!) =    8  (direct: 8)  s₂(10) = 2
  v₂( 20!) =   18  (direct: 18)  s₂(20) = 2
  v₂( 50!) =   47  (direct: 47)  s₂(50) = 3
  v₂(100!) =   97  (direct: 97)  s₂(100) = 3

=== Numbers with v₂(n) ≥ k up to 64 ===
  k=0: 64 numbers up to 64
  k=1: 32 numbers up to 64
  k=2: 16 numbers up to 64
  k=3: 8 numbers up to 64
  k=4: 4 numbers up to 64
  k=5: 2 numbers up to 64
  k=6: 1 numbers up to 64

=== Sum of v₂(n) for n = 1..N ===
  N=2^1-1: Σv₂ = 0
  N=2^2-1: Σv₂ = 1
  N=2^3-1: Σv₂ = 4
  N=2^4-1: Σv₂ = 11
  N=2^5-1: Σv₂ = 26
  N=2^6-1: Σv₂ = 57
  N=2^7-1: Σv₂ = 120
  N=2^8-1: Σv₂ = 247
  N=2^9-1: Σv₂ = 502
  N=2^10-1: Σv₂ = 1013

=== v₂ of central binomial coefficients ===
  v₂(C(2,1)) = s₂(1) = 1
  v₂(C(4,2)) = s₂(2) = 1
  v₂(C(6,3)) = s₂(3) = 2
  v₂(C(8,4)) = s₂(4) = 1
  v₂(C(10,5)) = s₂(5) = 2
  v₂(C(12,6)) = s₂(6) = 2
  v₂(C(14,7)) = s₂(7) = 3
  v₂(C(16,8)) = s₂(8) = 1
  v₂(C(18,9)) = s₂(9) = 2
  v₂(C(20,10)) = s₂(10) = 2
  v₂(C(22,11)) = s₂(11) = 3
  v₂(C(24,12)) = s₂(12) = 2
  v₂(C(26,13)) = s₂(13) = 3
  v₂(C(28,14)) = s₂(14) = 3
  v₂(C(30,15)) = s₂(15) = 4
  v₂(C(32,16)) = s₂(16) = 1
