  N= 2: distinct=     3 out of 3
  N= 3: distinct=     6 out of 6
  N= 4: distinct=     9 out of 10
  N= 5: distinct=    14 out of 15
  N= 6: distinct=    18 out of 21
  N= 7: distinct=    25 out of 28
  N= 8: distinct=    30 out of 36
  N= 9: distinct=    36 out of 45
  N=10: distinct=    42 out of 55
  N=11: distinct=    53 out of 66
  N=12: distinct=    59 out of 78
  N=13: distinct=    72 out of 91
  N=14: distinct=    80 out of 105
  N=15: distinct=    89 out of 120

=== Sum of all products ===
  N= 2: Σa·b = 7
  N= 3: Σa·b = 25
  N= 4: Σa·b = 65
  N= 5: Σa·b = 140
  N= 6: Σa·b = 266
  N= 7: Σa·b = 462
  N= 8: Σa·b = 750
  N= 9: Σa·b = 1155
  N=10: Σa·b = 1705
